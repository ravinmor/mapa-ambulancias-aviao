# Zero setup necessario pra rodar em modo demo — o docker-compose.yml ja usa
# esses valores por padrao. Este arquivo e so referencia: documenta as variaveis
# que sync-job/ e api/ leem, principalmente as de DATA_SOURCE=sharepoint (as
# mesmas que entram no k8s/secret.example.yaml na hora do deploy real).

DATABASE_URL=postgres://postgres:postgres_local_dev@localhost:5432/vehicles
PORT=3000
# Frota: quanto mais rapido, mais "ao vivo" a posicao no mapa. Historico e
# eventos de missao tem loop PROPRIO, bem mais espacado (30s por padrao) —
# a origem real so escreve a cada ~30s por van, entao bater esses 2 no mesmo
# ritmo da frota so gera chamada redundante (suspeita de ter contribuido pro
# throttling visto no flow de historico).
SYNC_INTERVAL_MS=5000
HISTORY_SYNC_INTERVAL_MS=30000
MISSION_EVENT_SYNC_INTERVAL_MS=30000
BROADCAST_INTERVAL_MS=5000
CORS_ORIGIN=*
VITE_API_BASE_URL=
DATA_SOURCE=simulated
CENTER_LAT=-23.5505
CENTER_LON=-46.6333
HISTORY_WINDOW_HOURS=24
HISTORY_ROW_LIMIT=5000
HISTORY_RETENTION_DAYS=30

# Necessario apenas quando DATA_SOURCE=sharepoint — URL completa do gatilho
# HTTP de cada flow no Power Automate (ja vem com ?sig=... embutido, que
# funciona como segredo). Nunca commitar o valor real aqui, so o nome da
# variavel — ver DECISOES_Infra_MapaAmbulancias.md pra como montar os flows.
# So FLEET_URL e obrigatoria (e o unico flow que acende posicao no mapa) —
# TRACKING_URL/MISSION_EVENTS_URL sao opcionais, o sync-job pula esses
# ciclos (com aviso no log) enquanto nao forem preenchidas.
POWER_AUTOMATE_FLEET_URL=
POWER_AUTOMATE_TRACKING_URL=
POWER_AUTOMATE_MISSION_EVENTS_URL=
# f_Operacao_Controle_Dados_do_Chamado — fonte da linha do tempo (missao).
# O flow nao filtra nada: devolve os 300 chamados mais recentes ordenados por
# "ID desc" e o sync faz upsert de todos a cada ciclo. Motivo de nao usar
# cursor incremental: "Modified" nao e indexada e a lista passou de 5.000
# itens, entao o SharePoint recusaria o filtro (mesmo bloqueio que derrubou o
# historico de posicoes). Ver sync-job/src/types.ts.
POWER_AUTOMATE_MISSIONS_URL=
MISSION_SYNC_INTERVAL_MS=30000
# f_Regulação_chamados — endereco/local por extenso (Nome_do_Local_Origem/
# Destino) + dado do paciente. Mission.originAddress/destinationAddress
# equivalente vem sempre vazio na origem; esta lista e o complemento.
# Regulation.id = Mission.callId (confirmado pelo usuario, 2026-08-24) —
# mesmo padrao de "sem filtro, so os N mais recentes por ID desc" das outras
# listas de escrita frequente.
POWER_AUTOMATE_REGULATIONS_URL=
REGULATION_SYNC_INTERVAL_MS=30000

# --- Aeronaves (OpenSky Network) -------------------------------------------
# Sem OPENSKY_CLIENT_ID/OPENSKY_CLIENT_SECRET preenchidas, acesso ANONIMO: a
# cota e de 400 creditos por dia e POR IP (medido pelo header
# X-Rate-Limit-Remaining), e uma chamada nesse bounding box custa 1 credito.
#
# ATENCAO ao intervalo: a 5 min sao 288 chamadas/dia SE o sync-job ficar
# ligado 24h. Medicao real de 2026-08-22 mostrou que o consumo de terceiros no
# mesmo IP (provedor com IP compartilhado) e ~1:1 com o nosso, entao ligado o
# tempo todo a cota NAO fecha. O uso previsto e ligar so durante as sessoes de
# trabalho — lembrar de "docker compose stop" ao terminar.
#
# "fixture" le uma amostra real gravada em disco e nao gasta credito nenhum;
# use durante trabalho longo de frontend. O docker-compose.yml usa "live" por
# padrao (e o ambiente que roda de verdade); config.ts usa "fixture".
OPENSKY_SOURCE=live

# Autenticado (opt-in, pedido do usuario 2026-09-03) — sobe a cota pra 4.000
# creditos/dia (10x). Precisa de conta em opensky-network.org + um client
# OAuth2 criado no dashboard da conta (usuario/senha simples foi aposentado
# pelo OpenSky em marco/2026). Nunca commitar o valor real, so o nome da
# variavel. Ver sources/openskyAuth.ts.
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
AIRCRAFT_SYNC_INTERVAL_MS=300000
AIRCRAFT_BROADCAST_INTERVAL_MS=30000
AIRCRAFT_HISTORY_RETENTION_DAYS=30
AIRCRAFT_HISTORY_WINDOW_HOURS=24
# Corta o rastro quando o intervalo entre dois pontos passa disso. A aeronave
# e identificada pelo icao24, entao se ela sai da area e volta horas depois
# reocupa a MESMA linha — sem o corte, o trajeto ligaria os dois trechos com
# uma reta atravessando o mapa.
AIRCRAFT_TRAIL_GAP_MINUTES=20
# Bounding box cobrindo SP e RJ numa unica chamada (duas chamadas separadas
# custariam o dobro pelo mesmo dado). OPENSKY_REGION_SPLIT_LON e a longitude
# que separa as duas regioes — -45.0 fica no meio entre SP (-46.6) e RJ (-43.2).
OPENSKY_LAMIN=-24.5
OPENSKY_LOMIN=-47.5
OPENSKY_LAMAX=-22.0
OPENSKY_LOMAX=-42.5
OPENSKY_REGION_SPLIT_LON=-45.0
OPENSKY_SLOTS_PER_REGION=5
