{
  "name": "vehicle-tracking-api",
  "version": "1.0.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "postinstall": "prisma generate && prisma generate --schema=prisma-resgate/schema",
    "migrate:resgate:deploy": "prisma migrate deploy --schema=prisma-resgate/schema",
    "migrate:resgate:dev": "prisma migrate dev --schema=prisma-resgate/schema",
    "build": "tsc",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@prisma/client": "^5.18.0",
    "dotenv": "^17.4.2",
    "express": "^4.19.2",
    "prisma": "^5.18.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.10",
    "typescript": "^5.5.4"
  }
}
