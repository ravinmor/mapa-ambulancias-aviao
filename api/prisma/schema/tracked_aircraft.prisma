// Aeronave ESPECIFICA rastreada por ICAO24 fixo — pipeline paralelo ao
// generico de aircraft.prisma (que fica intacto no schema/codigo, so parou
// de ser chamado, ver sync-job/src/index.ts). Diferenca central de regra: 1
// unica identidade fixa, sem vaga/regiao por proximidade, e NUNCA removida
// por sumir do ar — so marcada offline, mantendo a ultima posicao conhecida
// (pedido do usuario, elaboracao de 2026-09-01, ver TrackingPage/AmilJetPage
// no frontend).
model TrackedAircraft {
  id           Int       @id @default(autoincrement())
  icao24       String    @unique // endereco ICAO 24-bit do transponder em hex — chave estavel da aeronave
  label        String? // nome de exibicao configuravel (ex: "Jato Amil") — nao hardcodado no frontend
  callsign     String?
  latitude     Float?
  longitude    Float?
  altitude     Float? // metros — baro_altitude com fallback pra geo_altitude, igual ao pipeline generico
  velocity     Float? // m/s sobre o solo
  trueTrack    Float?    @map("true_track") // graus horarios a partir do norte — rotaciona o icone no mapa
  verticalRate Float?    @map("vertical_rate") // m/s, positivo = subindo
  onGround     Boolean   @default(false) @map("on_ground")
  // Codigo do transponder (4 digitos) — alerta visual nos 3 codigos
  // universais de emergencia: 7500 sequestro, 7600 falha de radio, 7700
  // emergencia geral (R-15, pedido do usuario 2026-09-02). Nao apagado
  // quando a aeronave fica offline (mesma logica de latitude/altitude
  // acima) — de proposito: sumir de sinal DURANTE uma emergencia deve
  // continuar alertando, nao limpar o alerta.
  squawk       String?
  // Fase do voo dentro da sequencia FIXA (ver STAGE_SEQUENCE em
  // sync-job/src/trackedAircraft.ts) — alimenta o arco de linha do tempo no
  // frontend, no estilo do telemetry de lancamento da SpaceX.
  stage        String?
  // Tier de recheck ATUAL (proximidade_final/proximidade_media/aproximacao/
  // voo/parado) — pedido do usuario, 2026-09-09, pra expor no log de
  // atividade do frontend (AmilActivityLog.tsx) qual escada de recheck a
  // aeronave esta usando agora. Calculado e escrito pelo sync-job a cada
  // checagem real (classifyApproachTier em trackedAircraft.ts) — nao e
  // reconstruido no frontend nem na api, so lido.
  tier         String?
  // false = nao apareceu no ultimo ciclo (fora do ar, sem ADS-B, fora de
  // alcance). Continua visivel no mapa com a ultima posicao conhecida —
  // nunca deletado por isso.
  isOnline     Boolean   @default(false) @map("is_online")
  positionAt   DateTime? @map("position_at") // "time_position" da origem — timestamp do fix, nao da chamada
  lastSeenAt   DateTime? @map("last_seen_at") // ultimo ciclo em que a aeronave apareceu online
  // Horario de inicio/fim do voo ATUAL (ou do ultimo, enquanto parada) — R-21,
  // pedido do usuario 2026-09-03: "o Command usara isso pra criar um
  // alerta", por isso a confirmacao em 2 leituras via pending*At abaixo (ver
  // resolveFlightTiming em sync-job/src/trackedAircraft.ts) antes de gravar
  // aqui — 1 leitura ruidosa isolada de on_ground nao pode disparar um
  // alerta falso no Command Center.
  flightStartedAt   DateTime? @map("flight_started_at")
  flightEndedAt     DateTime? @map("flight_ended_at")
  // Candidato NAO confirmado — decolagem/pouso "visto" numa unica leitura
  // real, aguardando a PROXIMA leitura real confirmar antes de virar
  // flightStartedAt/flightEndedAt oficial. Campo interno (nao exposto pela
  // API) — existe so pra sobreviver entre ciclos do sync-job.
  pendingDepartureAt DateTime? @map("pending_departure_at")
  pendingArrivalAt   DateTime? @map("pending_arrival_at")
  // Matricula/fabricante/modelo/operador — R-17, buscados 1x no adsbdb.com
  // (endpoint gratuito, sem autenticacao — SUBSTITUIU o endpoint de
  // metadados do OpenSky, descontinuado/410 Gone, confirmado 2026-09-04) e
  // cacheados aqui pra sempre (nao muda por aeronave, nao precisa rebuscar
  // todo ciclo). null = ainda nao buscado OU o adsbdb nao tem essa aeronave
  // catalogada (cobertura parcial, "unknown aircraft" e resposta normal).
  registration String?
  manufacturer String?
  model        String?
  operator     String?
  // Foto real da aeronave (pedido do usuario, 2026-09-04: "painel cabeçalho
  // com a imagem da aeronave") — cobertura bem mais parcial que o resto dos
  // metadados, null e o caso comum (frontend cai pro placeholder generico).
  photoUrl          String? @map("photo_url")
  photoThumbnailUrl String? @map("photo_thumbnail_url")
  // Origem/destino do voo ATUAL (R-18, pedido do usuario 2026-09-04) — via
  // adsbdb.com/v0/callsign/{callsign}, rebuscado sempre que o CALLSIGN muda
  // (voo novo = rota potencialmente nova). null = adsbdb nao conhece essa
  // rota (cobertura parcial, so rotas regulares/conhecidas).
  originIcao        String? @map("origin_icao")
  originName        String? @map("origin_name")
  destinationIcao   String? @map("destination_icao")
  destinationName   String? @map("destination_name")
  // Coordenadas do destino (pedido do usuario, 2026-09-04) — trava o dead
  // reckoning perto do pouso (ver useDeadReckoning.ts) e alimenta a linha
  // tracejada ate o destino no mapa (so no aviao selecionado).
  destinationLatitude  Float? @map("destination_latitude")
  destinationLongitude Float? @map("destination_longitude")
  // Callsign pro qual a rota acima foi buscada — permite saber se o
  // callsign mudou (voo novo) sem precisar comparar contra o campo
  // `callsign` acima, que so e atualizado DEPOIS da checagem de rota no
  // mesmo ciclo (ver checkOne em trackedAircraft.ts).
  routeCallsign     String? @map("route_callsign")
  // Ultima vez que o historico de voos passados (TrackedAircraftFlightHistory)
  // foi sincronizado com o OpenSky — gate de intervalo proprio (nao every
  // ciclo, ver HISTORY_SYNC_INTERVAL_MS em trackedAircraft.ts), pedido do
  // usuario 2026-09-04: "pegue a origem destino de voos passados".
  historySyncedAt   DateTime? @map("history_synced_at")
  // Agendamento de voo (2026-09-22) — ver comentario espelhado em
  // sync-job/prisma/schema/tracked_aircraft.prisma pro racional completo.
  // Escrito pelo sync-job (aircraftScheduling.ts), so LIDO aqui.
  schedulingStatus  String?   @map("scheduling_status")
  scheduledAt       DateTime? @map("scheduled_at")
  // Rastreamento alternativo via Garmin inReach MapShare — ver comentario
  // espelhado em sync-job/prisma/schema/tracked_aircraft.prisma. Escrito
  // pelo sync-job, so LIDO aqui.
  garminLatitude    Float?    @map("garmin_latitude")
  garminLongitude   Float?    @map("garmin_longitude")
  garminAltitude    Float?    @map("garmin_altitude")
  garminVelocity    Float?    @map("garmin_velocity")
  garminTrueTrack   Float?    @map("garmin_true_track")
  garminInEmergency Boolean?  @map("garmin_in_emergency")
  garminOnline      Boolean   @default(false) @map("garmin_online")
  garminPositionAt  DateTime? @map("garmin_position_at")
  updatedAt    DateTime  @default(now()) @map("updated_at")

  positionHistory TrackedAircraftPositionHistory[]
  garminPositionHistory GarminPositionHistory[]
  flightHistory   TrackedAircraftFlightHistory[]

  @@map("tracked_aircraft")
}

// Pernas de voo PASSADAS (R-31 cont., pedido do usuario 2026-09-04) — vem do
// endpoint /api/flights/aircraft do OpenSky (sources/openskyFlightsSource.ts),
// so ICAO dos aeroportos (o OpenSky nao da nome/municipio, so o adsbdb da —
// e so pra rota ATUAL, nao historica — por isso aqui fica so o codigo).
model TrackedAircraftFlightHistory {
  id                 Int      @id @default(autoincrement())
  trackedAircraftId  Int      @map("tracked_aircraft_id")
  callsign           String?
  departureIcao      String?  @map("departure_icao")
  arrivalIcao        String?  @map("arrival_icao")
  departedAt         DateTime @map("departed_at")
  arrivedAt          DateTime? @map("arrived_at")
  createdAt          DateTime @default(now()) @map("created_at")

  trackedAircraft TrackedAircraft @relation(fields: [trackedAircraftId], references: [id])

  // Evita duplicar a MESMA perna de voo se o sync rodar de novo sobre uma
  // janela que ja cobriu antes (as janelas de fetchRecentFlights podem se
  // sobrepor de proposito, pra nao arriscar buraco entre 2 syncs).
  @@unique([trackedAircraftId, departedAt])
  @@map("tracked_aircraft_flight_history")
}
