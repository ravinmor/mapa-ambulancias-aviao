// Projeto Prisma PRÓPRIO do núcleo `resgate` (Chamado/Operação/Veículo/...)
// — separado de propósito do prisma/ do sync-job/api (histórico de
// migration independente). Ver DESENHO_Schema_Resgate_Nucleo.md na raiz
// do repo pro racional completo. DATABASE_URL deve apontar pro banco
// `resgate` quando for aplicar de verdade — nunca pro `map-postgres` do
// sync-job.
generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["prismaSchemaFolder"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
